[Unit]
Description=KVN v5 WireGuard tunnel
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/usr/local/lib/kvn-v5
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m v5.modules.host_tunnel.worker start wireguard
ExecStop=/usr/bin/python3 -m v5.modules.host_tunnel.worker stop wireguard
TimeoutStartSec=120
TimeoutStopSec=80
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
SystemCallFilter=~@module
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
MemoryMax=48M
TasksMax=6
