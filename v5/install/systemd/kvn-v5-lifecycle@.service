[Unit]
Description=KVN v5 bounded module lifecycle request
After=kvn-v5-gateway.service

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/usr/local/lib/kvn-v5
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m v5.core.lifecycle.rpc --web-uid @WEB_UID@
StandardInput=socket
StandardOutput=null
StandardError=journal
RuntimeMaxSec=10min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/etc/kvn-v5/gateway /run/kvn-v5-gateway /var/lib/kvn-v5/packages /var/lib/kvn-v5/modules /var/lib/kvn-v5/users
ReadWritePaths=-/var/lib/kvn-v5/observability
InaccessiblePaths=/etc/kvn-v5/web /var/lib/kvn-v5/acme /var/lib/kvn-v5/tls /var/lib/kvn-v5/site
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/etc/ssh
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
SystemCallFilter=~@module
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_NET_BIND_SERVICE
MemoryMax=80M
TasksMax=16
