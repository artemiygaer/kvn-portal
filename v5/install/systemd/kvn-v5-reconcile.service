[Unit]
Description=KVN v5 restore committed module state
Wants=kvn-v5-gateway.service
After=kvn-v5-gateway.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory=/usr/local/lib/kvn-v5
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m v5.core.lifecycle.boot
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/etc/kvn-v5/gateway /run/kvn-v5-gateway /var/lib/kvn-v5/packages /var/lib/kvn-v5/modules /var/lib/kvn-v5/users
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
SystemCallFilter=~@module
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN CAP_NET_BIND_SERVICE
MemoryMax=80M
TasksMax=16

[Install]
WantedBy=multi-user.target
